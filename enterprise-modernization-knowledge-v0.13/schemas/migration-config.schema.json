{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterprise-modernization:migration-config:0.4",
  "title": "Migration Config for Java Version Parameterization",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "target",
    "toolchain",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.4"
    },
    "migration_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "spring_boot_version",
        "java"
      ],
      "properties": {
        "spring_boot_version": {
          "type": "string",
          "maxLength": 80
        },
        "java": {
          "type": "object",
          "required": [
            "feature_version"
          ],
          "properties": {
            "feature_version": {
              "type": "integer",
              "minimum": 8
            },
            "evidence": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "spring_boot_version",
        "java"
      ],
      "properties": {
        "spring_boot_version": {
          "type": "string",
          "maxLength": 80
        },
        "java": {
          "type": "object",
          "required": [
            "mode",
            "change_approved"
          ],
          "properties": {
            "mode": {
              "enum": [
                "preserve",
                "explicit"
              ]
            },
            "feature_version": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 8
            },
            "change_approved": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "explicit"
                  }
                }
              },
              "then": {
                "required": [
                  "feature_version"
                ],
                "properties": {
                  "feature_version": {
                    "type": "integer",
                    "minimum": 8
                  }
                }
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "required": [
        "compiler_release",
        "runtime_jdk"
      ],
      "properties": {
        "migration_tool_jdk": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 8
        },
        "compiler_release": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 8
        },
        "runtime_jdk": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 8
        },
        "ci_jdk": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 8
        },
        "docker_jdk": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 8
        },
        "docker_build_jdk": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 8
        },
        "ci_build_jdk": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 8
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "dependency_graph_verified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
